# ═══════════════════════════════════════════════════════════════════
#  СЕКРЕТНЫЕ НАСТРОЙКИ БОТА
#  Этот файл — как пароль от банка. Никогда не отправляйте его в чат,
#  не выкладывайте в интернет и на GitHub (там он уже закрыт .gitignore).
# ═══════════════════════════════════════════════════════════════════

# 1. Ключ бота. Где взять: Telegram → @BotFather → /newbot
#    (для уже созданного бота: /mybots → ваш бот → API Token → Revoke current token)
#    Выглядит так: цифры, двоеточие, потом длинный набор букв (1234567890:AA…)
BOT_TOKEN=

# 2. Кто управляет ботом (вы и менеджеры): личные номера в Telegram через запятую.
#    Свой номер узнаете так: запустите бота и напишите ему /myid
ADMIN_IDS=

# 3. По желанию: общий чат сотрудников, куда будут приходить заказы.
#    Добавьте бота в группу; номер группы начинается с минуса, например -1001234567890
ORDERS_CHAT_ID=

# 4. По желанию: онлайн-оплата ЮKassa (карта и СБП). Пока пусто — клиенты платят
#    при получении или по ссылке/реквизитам от менеджера.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Отправлять чек (54-ФЗ) через ЮKassa: 1 — да, 0 — нет (если кассу ведёте сами)
YOOKASSA_RECEIPT=1
# Ставка НДС в чеке: 1 — без НДС (УСН). Остальные коды — в кабинете ЮKassa
YOOKASSA_VAT_CODE=1

# 5. По желанию: если Telegram у вас не открывается без VPN — адрес прокси,
#    например socks5://127.0.0.1:1080  или  http://адрес:порт
PROXY_URL=

# Подробность журнала в чёрном окне: INFO (обычно) или DEBUG (для поиска ошибок)
LOG_LEVEL=INFO

# Только для опытных: адрес собственного сервера Telegram Bot API. Обычно пусто.
TELEGRAM_API_URL=
